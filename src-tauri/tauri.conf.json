{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Adhan Companion",
  "version": "0.1.9",
  "identifier": "io.github.marcosrehtanz.adhan-companion",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Adhan Companion",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "resources": [
      "assets/muecin/*",
      "assets/licenses/*"
    ],
    "linux": {
      "deb": {
        "depends": ["libasound2t64 | libasound2", "curl"]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
